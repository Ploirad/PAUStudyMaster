# MongoDB Configuration
MONGO_URL="mongodb://localhost:27017"
DB_NAME="pau_study_master"

# CORS Configuration
# For production, replace with your actual domain
# Example: CORS_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"
CORS_ORIGINS="*"

# LLM Integration
# Get your Emergent LLM Key from: https://emergent.sh/profile
# This key works with OpenAI, Anthropic, and Google AI services
EMERGENT_LLM_KEY="your_emergent_llm_key_here"

# Note: Never commit the actual .env file with real credentials to version control